# Copy this to .env and fill in real values.

# Leave as-is to use a local sqlite file for now.
# Swap in your Postgres URL when you're ready:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/sentient_notebooks
DATABASE_URL=sqlite:///./dev.db

# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-this-with-a-long-random-string

# Free at console.groq.com, no credit card needed.
GROQ_API_KEY=

# LLM_PROVIDER=groq       # or "ollama" for local dev on your own machine

# Leave as "local" for now -- files get saved to ./storage on disk.
# Switch to "s3" once you've set up Cloudflare R2 (see README).
# STORAGE_BACKEND=local
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# MAX_USERS=5
# MAX_STORAGE_BYTES_PER_USER=419430400   # 400MB
